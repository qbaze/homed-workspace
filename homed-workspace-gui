#!/usr/bin/env python3
# homed-workspace-gui — a small GTK window to activate / switch / log out homed
# clients on demand. Workspaces are dynamic: activating a client creates its
# workspace, logging out removes it. Same model as homed-workspace-menu (the rofi
# version), just a window instead. Bind it to a shortcut or launch from a menu.
import gi, os, subprocess, threading, time
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

# Close the palette automatically after an action (switch/activate/logout).
# Set HW_GUI_STAY=1 to keep it open instead.
CLOSE_AFTER = os.environ.get("HW_GUI_STAY", "") not in ("1", "true", "yes")

def sh(args, timeout=5):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""

# --- homed clients -----------------------------------------------------------
def list_clients():
    # every row of `homectl list` is a homed user (a client); col1=name, col4=state
    out = sh(["homectl", "list", "--no-legend"])
    rows = []
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 4:
            rows.append((f[0], f[3]))
    rows.sort()
    return rows

def client_state(name):
    for n, st in list_clients():
        if n == name:
            return st
    return ""

# --- XFCE workspaces (xfconf) ------------------------------------------------
def ws_names():
    out = sh(["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_names"])
    lines = out.splitlines()
    # output: first lines are a header ("Value is an array ...", blank), then names
    return [l for l in lines if l and not l.startswith("Value is an array")]

def ws_num_for_name(name):
    out = sh(["wmctrl", "-d"])
    for line in out.splitlines():
        f = line.split(None, 9)
        if len(f) >= 10 and f[9].strip() == name:
            return f[0]
    return None

def _set_ws_names(names):
    args = ["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_names"]
    if len(names) == 1:
        args.append("--force-array")
    for n in names:
        args += ["-t", "string", "-s", n]
    sh(args)

def add_ws(name):
    if ws_num_for_name(name):
        return
    names = ws_names() + [name]
    sh(["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_count",
        "-s", str(len(names))])
    _set_ws_names(names)

def remove_ws(name):
    names = ws_names()
    out = [n for n in names if n != name]
    if len(out) == len(names) or len(out) < 1:
        return
    sh(["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_count",
        "-s", str(len(out))])
    _set_ws_names(out)

def switch_ws(name):
    num = ws_num_for_name(name)
    if num is not None:
        sh(["wmctrl", "-s", num])

# --- windows owned by a client (for the logout confirmation) -----------------
def windows_of(name):
    out = sh(["wmctrl", "-l", "-p"])
    c = 0
    for line in out.splitlines():
        f = line.split(None, 4)
        if len(f) < 3 or not f[2].isdigit():
            continue
        try:
            with open(f"/proc/{f[2]}/status") as fh:
                uid = next((l.split()[1] for l in fh if l.startswith("Uid:")), None)
        except Exception:
            continue
        if uid and sh(["getent", "passwd", uid]).split(":")[0:1] == [name]:
            c += 1
    return c

# --- actions (slow bits run off the UI thread) -------------------------------
def activate(name, on_done):
    # needs the home password -> run homectl activate in a terminal
    subprocess.Popen(["xfce4-terminal", "-T", f"activate {name}",
                      "-x", "homectl", "activate", name])
    def worker():
        for _ in range(100):
            if client_state(name) == "active":
                break
            time.sleep(0.3)
        ok = client_state(name) == "active"
        if ok:
            add_ws(name); time.sleep(0.3); switch_ws(name)
        GLib.idle_add(on_done, ok)
    threading.Thread(target=worker, daemon=True).start()

def logout(name, on_done):
    def worker():
        sh(["loginctl", "terminate-user", name]); time.sleep(1)
        sh(["loginctl", "kill-user", "--signal=SIGKILL", name]); time.sleep(1)
        if sh(["homectl", "deactivate", name], timeout=15) is not None:
            pass
        time.sleep(0.5)
        if client_state(name) == "active":
            sh(["homectl", "deactivate", name], timeout=15)
        remove_ws(name)
        GLib.idle_add(on_done, True)
    threading.Thread(target=worker, daemon=True).start()

# --- UI ----------------------------------------------------------------------
class Win(Gtk.Window):
    def __init__(self):
        super().__init__(title="homed-workspace")
        self.set_default_size(340, 380)
        self.set_border_width(8)
        # behave like a lightweight palette, not a main window: float above, stay
        # out of the taskbar/pager, don't maximize, and sit in the top-right.
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_gravity(Gdk.Gravity.NORTH_EAST)
        self.connect("realize", self._place_top_right)
        self.connect("key-press-event", self._on_key)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.add(box)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        sw = Gtk.ScrolledWindow(); sw.set_vexpand(True); sw.add(self.listbox)
        box.pack_start(sw, True, True, 0)

        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", lambda *_: self.reload())
        box.pack_start(refresh, False, False, 0)

        self.reload()

    def _place_top_right(self, *_):
        disp = Gdk.Display.get_default()
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        g = mon.get_geometry()
        w, h = self.get_size()
        self.move(g.x + g.width - w - 24, g.y + 48)

    def _on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:      # Esc dismisses the palette
            self.close()
        return False

    def _done(self):
        if CLOSE_AFTER:
            self.close()
        else:
            self.reload()

    def reload(self):
        for row in self.listbox.get_children():
            self.listbox.remove(row)
        for name, state in list_clients():
            self.listbox.add(self._row(name, state))
        self.listbox.show_all()

    def _row(self, name, state):
        row = Gtk.ListBoxRow()
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        h.set_margin_top(4); h.set_margin_bottom(4)
        h.set_margin_start(6); h.set_margin_end(6)

        dot = {"active": "●", "absent": "○"}.get(state, "○")
        lbl = Gtk.Label(label=f"{dot}  {name}", xalign=0)
        lbl.set_hexpand(True)
        h.pack_start(lbl, True, True, 0)

        st = Gtk.Label(label=state); st.get_style_context().add_class("dim-label")
        h.pack_start(st, False, False, 0)

        if state == "active":
            b_sw = Gtk.Button(label="Switch")
            b_sw.connect("clicked", lambda *_: (switch_ws(name), self._done()))
            h.pack_start(b_sw, False, False, 0)
            b_out = Gtk.Button(label="Log out")
            b_out.get_style_context().add_class("destructive-action")
            b_out.connect("clicked", lambda *_: self._logout(name))
            h.pack_start(b_out, False, False, 0)
        elif state == "absent":
            na = Gtk.Label(label="home absent")
            na.get_style_context().add_class("dim-label")
            h.pack_start(na, False, False, 0)
        else:  # inactive / dirty
            b_act = Gtk.Button(label="Activate")
            b_act.get_style_context().add_class("suggested-action")
            b_act.connect("clicked", lambda *_: self._activate(name))
            h.pack_start(b_act, False, False, 0)

        row.add(h)
        return row

    def _busy(self, msg):
        for row in self.listbox.get_children():
            self.listbox.remove(row)
        r = Gtk.ListBoxRow(); r.add(Gtk.Label(label=msg, xalign=0))
        self.listbox.add(r); self.listbox.show_all()

    def _activate(self, name):
        self._busy(f"activating {name} — enter password in the terminal…")
        # on success the palette has done its job -> close; on failure show the list
        activate(name, lambda ok: (self._done() if ok else self.reload()))

    def _logout(self, name):
        n = windows_of(name)
        if n > 0:
            d = Gtk.MessageDialog(transient_for=self, modal=True,
                                  message_type=Gtk.MessageType.WARNING,
                                  buttons=Gtk.ButtonsType.OK_CANCEL,
                                  text=f"{name} has {n} open window(s).")
            d.format_secondary_text("Logging out will close them. Continue?")
            resp = d.run(); d.destroy()
            if resp != Gtk.ResponseType.OK:
                return
        self._busy(f"logging out {name}…")
        logout(name, lambda ok: self._done())

def main():
    w = Win()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
