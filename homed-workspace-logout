#!/usr/bin/env bash
# homed-workspace-logout — terminate client homed sessions and deactivate their
# encrypted homes. Runs as root from pam_exec (close_session of the main user).
# Safe to run manually: sudo homed-workspace-logout
set -uo pipefail

if [[ -n ${PAM_TYPE:-} && ${PAM_TYPE} != close_session ]]; then exit 0; fi
KEEP="${PAM_USER:-}"

mapfile -t users < <(homectl list --no-legend 2>/dev/null | awk '{print $1}')
[[ ${#users[@]} -gt 0 ]] || exit 0
drop=(); for u in "${users[@]}"; do [[ $u == "$KEEP" ]] || drop+=("$u"); done
[[ ${#drop[@]} -gt 0 ]] || exit 0

# Revoke the X access runas granted to clients (least-privilege cleanup)
for u in "${drop[@]}"; do xhost "-si:localuser:$u" 2>/dev/null || true; done

# disable linger first, else systemd resurrects user@UID.service and keeps the
# home busy, making deactivate fail.
for u in "${drop[@]}"; do loginctl disable-linger "$u" 2>/dev/null || true; done
# polite SIGTERM: let the clients' apps save & close
for u in "${drop[@]}"; do loginctl terminate-user "$u" 2>/dev/null || true; done
# wait up to ~8s for processes to exit cleanly before forcing
for _ in $(seq 1 16); do
  busy=0
  for u in "${drop[@]}"; do pgrep -u "$u" >/dev/null 2>&1 && busy=1; done
  [[ $busy -eq 0 ]] && break
  sleep 0.5
done
# force-kill only those still running
for u in "${drop[@]}"; do
  pgrep -u "$u" >/dev/null 2>&1 && loginctl kill-user --signal=SIGKILL "$u" 2>/dev/null || true
done
sleep 1
for u in "${drop[@]}"; do
  homectl deactivate "$u" 2>/dev/null || { sleep 1; homectl deactivate "$u" 2>/dev/null || true; }
done
exit 0
