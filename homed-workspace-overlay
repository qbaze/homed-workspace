#!/usr/bin/env python3
# homed-workspace-overlay — persistent, always-on-top, click-through overlay
# showing the current workspace name in a corner of EVERY connected monitor.
# Updates on workspace change; rebuilds when monitors are plugged/unplugged.
# Opt-in, runs as a `systemctl --user` service.
import gi, os, signal, subprocess, cairo
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

LIB = "/usr/lib/homed-workspace/lib.sh"
CORNER  = os.environ.get("HW_OVERLAY_CORNER", "top-right")
MARGIN  = int(os.environ.get("HW_OVERLAY_MARGIN", "24"))
OPACITY = float(os.environ.get("HW_OVERLAY_OPACITY", "0.5"))        # badge background
TEXT_OPACITY = float(os.environ.get("HW_OVERLAY_TEXT_OPACITY", "1.0"))  # the label text
POLL_MS = int(os.environ.get("HW_OVERLAY_POLL_MS", "250"))

_CSS = f"""
    window {{ background-color: rgba(0,0,0,{OPACITY}); border-radius: 10px; }}
    label  {{
        color: rgba(255,255,255,{TEXT_OPACITY}); font-size: 18px; font-weight: bold;
        text-shadow: -1px -1px 0 #000, 1px -1px 0 #000,
                     -1px  1px 0 #000, 1px  1px 0 #000,
                      0px  2px 3px rgba(0,0,0,0.9);
    }}
"""

def current_ws():
    try:
        out = subprocess.run(["bash", "-c", f"source {LIB}; current_ws"],
                             capture_output=True, text=True, timeout=2)
        return out.stdout.strip()
    except Exception:
        return ""

class CornerWindow(Gtk.Window):
    """One overlay window pinned to the corner of a single monitor."""
    def __init__(self, geometry):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.geometry = geometry
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_accept_focus(False)
        self.set_resizable(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.stick()

        screen = self.get_screen()
        vis = screen.get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.set_app_paintable(True)

        self.label = Gtk.Label()
        self.label.set_margin_top(8); self.label.set_margin_bottom(8)
        self.label.set_margin_start(16); self.label.set_margin_end(16)
        self.add(self.label)

        self.connect("realize", self._click_through)
        self.connect("map", self._click_through)          # also after every show
        self.connect("size-allocate", lambda *_: (self._reposition(), self._click_through()))

    def _click_through(self, *_):
        # Make the whole window transparent to input so clicks reach whatever is
        # underneath. Re-applied after realize, map and size changes because GTK
        # can otherwise reset the input region to the full window.
        win = self.get_window()
        if win is not None:
            empty = cairo.Region()
            win.input_shape_combine_region(empty, 0, 0)
            # belt-and-suspenders: some GTK builds honour the pass-through flag
            try:
                win.set_pass_through(True)
            except Exception:
                pass

    def _reposition(self):
        g = self.geometry
        w, h = self.get_size()
        x = g.x + (g.width  - w - MARGIN if "right"  in CORNER else MARGIN)
        y = g.y + (g.height - h - MARGIN if "bottom" in CORNER else MARGIN)
        self.move(x, y)

    def set_text(self, text):
        self.label.set_text(text)
        self.show_all()
        self._reposition()

class OverlayManager:
    """Owns one CornerWindow per monitor; rebuilds on monitor hotplug."""
    def __init__(self):
        self.display = Gdk.Display.get_default()
        self.screen = Gdk.Screen.get_default()
        self.windows = []
        self._last = None

        Gtk.StyleContext.add_provider_for_screen(
            self.screen, self._css(), Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # rebuild windows when monitors change (dock/undock, resolution change)
        self.display.connect("monitor-added",   lambda *_: self._rebuild())
        self.display.connect("monitor-removed", lambda *_: self._rebuild())
        self.screen.connect("size-changed",     lambda *_: self._rebuild())

        self._rebuild()
        GLib.timeout_add(POLL_MS, self._tick)

    def _css(self):
        p = Gtk.CssProvider(); p.load_from_data(_CSS.encode()); return p

    def _rebuild(self):
        for w in self.windows:
            w.destroy()
        self.windows = []
        n = self.display.get_n_monitors()
        for i in range(n):
            mon = self.display.get_monitor(i)
            geo = mon.get_geometry()
            win = CornerWindow(geo)
            self.windows.append(win)
        self._last = None          # force repaint of the fresh windows
        self._tick()
        return False

    def _tick(self):
        name = current_ws()
        if name and name != self._last:
            self._last = name
            for w in self.windows:
                w.set_text(name)
        elif not name:
            for w in self.windows:
                w.hide()
        return True

def main():
    signal.signal(signal.SIGINT,  lambda *_: Gtk.main_quit())
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    OverlayManager()
    Gtk.main()

if __name__ == "__main__":
    main()
