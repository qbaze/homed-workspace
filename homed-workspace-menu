#!/usr/bin/env bash
# homed-workspace-menu — rofi menu to activate / switch / log out homed clients
# on demand. Workspaces are dynamic: activating a client creates its workspace,
# logging out removes it. Bind this to a shortcut.
#
# Model: the set of ACTIVE homed clients is the source of truth; workspaces mirror
# it. Only active clients (plus you) have a workspace.
set -uo pipefail

_LIB=/usr/lib/homed-workspace/lib.sh
[[ -r $_LIB ]] || _LIB="$(dirname "$(readlink -f "$0")")/lib/lib.sh"
# shellcheck source=/dev/null
source "$_LIB"   # is_client, current_ws

# --- menu backend (rofi preferred, dmenu fallback) ---------------------------
menu() {  # $1 = prompt ; entries on stdin
  if command -v rofi >/dev/null 2>&1; then
    rofi -dmenu -i -p "$1"
  elif command -v dmenu >/dev/null 2>&1; then
    dmenu -p "$1"
  else
    echo "homed-workspace-menu: need rofi or dmenu" >&2; exit 1
  fi
}
confirm() {  # $1 = question -> 0 if yes
  local ans
  ans=$(printf 'No\nYes\n' | menu "$1")
  [[ $ans == Yes ]]
}

# --- XFCE workspace helpers (xfconf) ------------------------------------------
ws_names() { xfconf-query -c xfwm4 -p /general/workspace_names 2>/dev/null | tail -n +3; }
ws_count() { xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null; }

ws_num_for_name() {  # name -> desktop number, or nothing
  wmctrl -d | awk -v want="$1" '{ name=$10; for(i=11;i<=NF;i++) name=name" "$i; if(name==want) print $1 }'
}

set_ws_names() {  # args = full ordered list of names
  local a=(); local n
  for n in "$@"; do a+=(-t string -s "$n"); done
  if [[ ${#a[@]} -eq 2 ]]; then
    xfconf-query -c xfwm4 -p /general/workspace_names --force-array "${a[@]}"
  else
    xfconf-query -c xfwm4 -p /general/workspace_names "${a[@]}"
  fi
}

add_ws() {  # name -> ensure a workspace named $1 exists
  ws_num_for_name "$1" >/dev/null && [[ -n $(ws_num_for_name "$1") ]] && return 0
  mapfile -t names < <(ws_names)
  names+=("$1")
  xfconf-query -c xfwm4 -p /general/workspace_count -s "${#names[@]}"
  set_ws_names "${names[@]}"
}

remove_ws() {  # name -> drop the workspace named $1 (if present)
  mapfile -t names < <(ws_names)
  local out=(); local n
  for n in "${names[@]}"; do [[ $n == "$1" ]] || out+=("$n"); done
  [[ ${#out[@]} -eq ${#names[@]} ]] && return 0        # nothing removed
  [[ ${#out[@]} -ge 1 ]] || return 0                   # never go to zero
  xfconf-query -c xfwm4 -p /general/workspace_count -s "${#out[@]}"
  set_ws_names "${out[@]}"
}

switch_ws() {  # name -> switch to its workspace
  local num; num=$(ws_num_for_name "$1")
  [[ -n $num ]] && wmctrl -s "$num"
}

# --- client state -------------------------------------------------------------
client_state() {  # name -> active|inactive|...
  homectl list --no-legend 2>/dev/null | awk -v u="$1" '$1==u{print $4}'
}
windows_of() {  # name -> count of open windows owned by that user
  local c=0 pid uid owner
  while read -r _ _ pid _ _; do
    [[ $pid =~ ^[0-9]+$ && $pid -gt 0 ]] || continue
    uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null) || continue
    owner=$(getent passwd "$uid" | cut -d: -f1)
    [[ $owner == "$1" ]] && c=$((c+1))
  done < <(wmctrl -l -p)
  echo "$c"
}

# --- activation (needs password -> terminal) ---------------------------------
activate_client() {  # name
  xfce4-terminal -T "activate $1" -x homectl activate "$1"
  for _ in $(seq 1 100); do [[ $(client_state "$1") == active ]] && break; sleep 0.3; done
  [[ $(client_state "$1") == active ]] || { notify-send "homed-workspace" "activation of $1 failed" 2>/dev/null; return 1; }
  add_ws "$1"; sleep 0.3; switch_ws "$1"
}

logout_client() {  # name
  local w; w=$(windows_of "$1")
  if [[ $w -gt 0 ]]; then
    confirm "$1 has $w open window(s). Log out and close them?" || return 0
  fi
  loginctl terminate-user "$1" 2>/dev/null || true
  sleep 1
  loginctl kill-user --signal=SIGKILL "$1" 2>/dev/null || true
  sleep 1
  homectl deactivate "$1" 2>/dev/null || { sleep 1; homectl deactivate "$1" 2>/dev/null || true; }
  remove_ws "$1"
}

# --- build the menu -----------------------------------------------------------
build_entries() {
  local u st
  while read -r u; do
    is_client "$u" || continue
    st=$(client_state "$u")
    if [[ $st == active ]]; then echo "● $u  (active — switch)"; else echo "○ $u  (activate)"; fi
  done < <(homectl list --no-legend 2>/dev/null | awk '{print $1}' | sort)
  echo "⏻ log out a client…"
}

main() {
  local choice name
  choice=$(build_entries | menu "workspace") || exit 0
  [[ -n $choice ]] || exit 0

  if [[ $choice == "⏻ log out a client…" ]]; then
    # second menu: only active clients
    name=$(homectl list --no-legend 2>/dev/null | awk '$4=="active"{print $1}' \
             | while read -r u; do is_client "$u" && echo "$u"; done | menu "log out") || exit 0
    [[ -n $name ]] && logout_client "$name"
    exit 0
  fi

  name=$(awk '{print $2}' <<<"$choice")   # strip the ●/○ icon
  case "$(client_state "$name")" in
    active) switch_ws "$name" ;;
    "" | absent) notify-send "homed-workspace" "$name: home absent, cannot activate" 2>/dev/null ;;
    *) activate_client "$name" ;;
  esac
}
main
