#!/usr/bin/env python3
# homed-workspace-tray — a panel tray icon with a dropdown switcher for homed
# clients: click it to activate / switch / log out clients. Workspaces are
# dynamic (activating creates the workspace, logging out removes it). Meant to
# autostart in your session and sit in the XFCE panel's notification area.
import gi, os, getpass, subprocess, threading, time
gi.require_version("Gtk", "3.0")
# AppIndicator: prefer the maintained Ayatana fork, fall back to the old one.
_ind = None
for _name, _ver in (("AyatanaAppIndicator3", "0.1"), ("AppIndicator3", "0.1")):
    try:
        gi.require_version(_name, _ver)
        _ind = __import__("gi.repository", fromlist=[_name])
        _ind = getattr(_ind, _name)
        break
    except Exception:
        continue
from gi.repository import Gtk, GLib

if _ind is None:
    import sys
    sys.stderr.write("homed-workspace-tray: need libayatana-appindicator "
                     "(or libappindicator-gtk3)\n")
    sys.exit(1)


def sh(args, timeout=5):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""

# --- clients & workspaces (same ops as the GUI/menu) -------------------------
def list_clients():
    rows = []
    for line in sh(["homectl", "list", "--no-legend"]).splitlines():
        f = line.split()
        if len(f) >= 4:
            rows.append((f[0], f[3]))
    rows.sort()
    return rows

def current_ws_list():
    # The authoritative list of workspaces is what the WM actually has (wmctrl -d),
    # not the xfconf workspace_names property, which can hold stale/extra entries
    # and desync (producing phantom "Workspace N" names when count > names).
    res = []
    for line in sh(["wmctrl", "-d"]).splitlines():
        f = line.split(None, 9)
        if len(f) >= 10:
            res.append(f[9].strip())
    return res

def ws_num_for_name(name):
    for line in sh(["wmctrl", "-d"]).splitlines():
        f = line.split(None, 9)
        if len(f) >= 10 and f[9].strip() == name:
            return f[0]
    return None

def _apply_ws(names):
    # Set NAMES before COUNT. If count rises before the names array holds the new
    # entry, xfwm auto-generates a default "Workspace N" label for the new slot.
    # Writing names first (count then catches up) keeps every slot correctly named.
    args = ["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_names"]
    if len(names) == 1:
        args.append("--force-array")
    for n in names:
        args += ["-t", "string", "-s", n]
    sh(args)
    sh(["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_count",
        "-s", str(len(names))])

def add_ws(name):
    cur = current_ws_list()
    if name in cur:
        return
    _apply_ws(cur + [name])

def remove_ws(name):
    cur = current_ws_list()
    out = [n for n in cur if n != name]
    if len(out) == len(cur) or len(out) < 1:   # nothing to remove / never empty
        return
    _apply_ws(out)

def sync_ws():
    # Recompute the workspace list from truth: the main user plus the currently
    # active homed clients. Anything else (orphans like a stray "Workspace N",
    # or a just-logged-out client) is dropped. Existing order is preserved; new
    # active clients are appended. This self-heals leftovers instead of relying
    # on name-matched add/remove.
    main = getpass.getuser()
    active = [n for n, st in list_clients() if st == "active"]
    cur = current_ws_list()
    keep = [w for w in cur if w == main or w in active]
    if main and main not in keep:
        keep.insert(0, main)
    for c in active:
        if c not in keep:
            keep.append(c)
    if keep and keep != cur:
        _apply_ws(keep)

def switch_ws(name):
    num = ws_num_for_name(name)
    if num is not None:
        sh(["wmctrl", "-s", num])

def _win_owner(pid):
    # username owning the process behind a window pid, or "" if unknown
    try:
        with open(f"/proc/{pid}/status") as fh:
            uid = next((l.split()[1] for l in fh if l.startswith("Uid:")), None)
    except Exception:
        return ""
    if not uid:
        return ""
    name = sh(["getent", "passwd", uid]).split(":")[0:1]
    return name[0] if name else ""

def _iter_windows():
    # yield (winid, desktop, owner) for every managed window
    for line in sh(["wmctrl", "-l", "-p"]).splitlines():
        f = line.split(None, 4)
        if len(f) < 3 or not f[2].isdigit():
            continue
        yield f[0], f[1], _win_owner(f[2])

def windows_of(name):
    return sum(1 for _wid, _d, owner in _iter_windows() if owner == name)

def ws_name_to_num():
    m = {}
    for line in sh(["wmctrl", "-d"]).splitlines():
        f = line.split(None, 9)
        if len(f) >= 10:
            m[f[9].strip()] = f[0]
    return m

def tidy_windows():
    # Move every window onto the workspace named after its owning user, so a
    # client's stray windows return to that client's desktop (and the main
    # user's to theirs). Windows whose owner has no workspace are left alone.
    ws = ws_name_to_num()
    moved = 0
    for winid, desk, owner in _iter_windows():
        target = ws.get(owner)
        # desk "-1" = pinned to all workspaces (panel, desktop, docks); moving
        # such a window would unstick it, so leave it where it is.
        if target is None or desk == "-1" or target == desk:
            continue
        sh(["wmctrl", "-i", "-r", winid, "-t", target])
        moved += 1
    return moved

def client_state(name):
    for n, st in list_clients():
        if n == name:
            return st
    return ""

# --- actions (slow bits off the main loop) -----------------------------------
def do_activate(name, after):
    subprocess.Popen(["xfce4-terminal", "-T", f"activate {name}",
                      "-x", "homectl", "activate", name])
    def worker():
        for _ in range(100):
            if client_state(name) == "active":
                break
            time.sleep(0.3)
        if client_state(name) == "active":
            sync_ws(); time.sleep(0.3); switch_ws(name)
        else:
            GLib.idle_add(notify, f"activation of {name} failed")
        GLib.idle_add(after)
    threading.Thread(target=worker, daemon=True).start()

def do_logout(name, after):
    def worker():
        # deactivation needs root (homed blocks cross-user deactivate); the polkit
        # rule lets wheel run this helper via pkexec without a password.
        r = subprocess.run(["pkexec", "/usr/bin/homed-workspace-deactivate", name])
        if r.returncode == 0:
            sync_ws()              # recompute from truth (drops this client + orphans)
        else:
            GLib.idle_add(notify, f"could not log out {name}")
        GLib.idle_add(after)
    threading.Thread(target=worker, daemon=True).start()

def notify(msg):
    sh(["notify-send", "homed-workspace", msg])

def confirm(text, secondary):
    d = Gtk.MessageDialog(modal=True, message_type=Gtk.MessageType.WARNING,
                          buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
    d.format_secondary_text(secondary)
    d.set_keep_above(True)
    r = d.run(); d.destroy()
    return r == Gtk.ResponseType.OK

# --- tray --------------------------------------------------------------------
class Tray:
    def __init__(self):
        self.ind = _ind.Indicator.new(
            "homed-workspace", "system-users",
            _ind.IndicatorCategory.APPLICATION_STATUS)
        self.ind.set_status(_ind.IndicatorStatus.ACTIVE)
        self.ind.set_title("Workspace clients")
        self.rebuild()

    def rebuild(self):
        m = Gtk.Menu()
        clients = list_clients()
        if not clients:
            mi = Gtk.MenuItem(label="(no homed clients)"); mi.set_sensitive(False)
            m.append(mi)
        for name, state in clients:
            if state == "active":
                mi = Gtk.MenuItem(label=f"●  {name}  —  switch")
                mi.connect("activate", lambda _w, n=name: switch_ws(n))
            elif state == "absent":
                mi = Gtk.MenuItem(label=f"○  {name}  (home absent)")
                mi.set_sensitive(False)
            else:
                mi = Gtk.MenuItem(label=f"○  {name}  —  activate")
                mi.connect("activate", lambda _w, n=name: do_activate(n, self.rebuild))
            m.append(mi)

        active = [n for n, s in clients if s == "active"]
        if active:
            m.append(Gtk.SeparatorMenuItem())
            out = Gtk.MenuItem(label="Log out a client")
            sub = Gtk.Menu()
            for n in active:
                it = Gtk.MenuItem(label=n)
                it.connect("activate", lambda _w, nn=n: self._logout(nn))
                sub.append(it)
            out.set_submenu(sub)
            m.append(out)

        m.append(Gtk.SeparatorMenuItem())
        t = Gtk.MenuItem(label="Tidy windows to workspaces")
        t.connect("activate", lambda *_: self._tidy())
        m.append(t)
        r = Gtk.MenuItem(label="Refresh"); r.connect("activate", lambda *_: self.rebuild())
        m.append(r)
        q = Gtk.MenuItem(label="Quit"); q.connect("activate", lambda *_: Gtk.main_quit())
        m.append(q)

        m.show_all()
        self.ind.set_menu(m)

    def _tidy(self):
        n = tidy_windows()
        notify(f"moved {n} window(s)" if n else "windows already in place")

    def _logout(self, name):
        n = windows_of(name)
        if n > 0 and not confirm(f"{name} has {n} open window(s).",
                                 "Logging out will close them. Continue?"):
            return
        do_logout(name, self.rebuild)

def main():
    Tray()
    Gtk.main()

if __name__ == "__main__":
    main()
